{
  "expo": {
    "name": "MemeIsMine",
    "slug": "memeismine",
    "scheme": "memeismine",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-media-library",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "MemeIsMine uses your photo library to create memes from your images.",
        "NSPhotoLibraryAddUsageDescription": "MemeIsMine saves exported memes to your photo library."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    }
  }
}