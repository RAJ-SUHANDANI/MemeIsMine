# Private indexed TablesDB likes table, already provisioned in this project.
APPWRITE_DATABASE_ID=mim
APPWRITE_LIKES_COLLECTION_ID=template_likes

# Set the SERVER-ONLY key in the hosting provider's secret variables.
# Do not commit real key values or use a NEXT_PUBLIC_ prefix.
APPWRITE_API_KEY=

# No custom SMTP, persistent SQLite server, or database service fee required.
