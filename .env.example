# Public site canonical URL. Update after final site activation.
NEXT_PUBLIC_SITE_URL=https://memeismine.vercel.app

# Connected Appwrite Cloud project (public configuration; not a secret).
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
