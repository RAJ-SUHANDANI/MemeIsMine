# Meme Is Mine public HTTPS domain, for SEO canonicals and sitemap.
NEXT_PUBLIC_SITE_URL=https://memeismine.vercel.app

# Appwrite Cloud Free - copy from your Appwrite project settings.
# Server-only; never add NEXT_PUBLIC_ to these values.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Appwrite DocumentsDB IDs created by "npm run setup:appwrite".
APPWRITE_DATABASE_ID=mim
APPWRITE_LIKES_COLLECTION_ID=template_likes

# No custom SMTP, local SQLite, or paid database required.
# Appwrite Cloud Free's built-in email service sends standard
# six-digit verification and recovery emails.
