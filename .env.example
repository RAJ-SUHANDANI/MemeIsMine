# Set this to the final public HTTPS domain before release.
# Ensures canonical links, social metadata, robots.txt and sitemap.xml agree.
NEXT_PUBLIC_SITE_URL=https://memeismine.vercel.app

# Own account database: mounted durable directory on a single Node.js host.
# Do NOT point this at a temporary serverless filesystem.
MIM_DATABASE_PATH=/data/accounts.sqlite

# At least 32 random characters (recommended: openssl rand -hex 32)
MIM_AUTH_SECRET=

# Real SMTP service for six-digit email verification and account recovery.
# Port 465 (implicit TLS) or 587 (required STARTTLS).
MIM_SMTP_HOST=
MIM_SMTP_PORT=465
MIM_SMTP_USER=
MIM_SMTP_PASSWORD=
MIM_SMTP_FROM=

# No Supabase, database service API, or client-side database credentials.
